{
  "name": "flais-keycloak-demo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "check": "npm run lint && tsc --noEmit",
    "build": "npm run check && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "keycloak-js": "26.2.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-json-view-lite": "2.5.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "globals": "17.14.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  },
  "engines": {
    "node": "26"
  }
}