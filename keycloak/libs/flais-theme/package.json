{
  "name": "flais-theme",
  "version": "0.0.1",
  "description": "Flais theme for Keycloak",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "check": "npm run lint && tsc --noEmit",
    "build": "npm run check && vite build",
    "build-keycloak-theme": "npm run build && keycloakify build",
    "storybook": "storybook dev -p 6006"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "keycloakify": "11.16.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@storybook/react": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "storybook": "10.6.0",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "engines": {
    "node": "26"
  }
}
